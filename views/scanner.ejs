<%- include('layouts/header') %>
<%- include('layouts/navbar') %>

<div class="main-wrapper">
  <!-- Active Activity Banner & Selection -->
  <div class="glass-card" style="margin-bottom: 1.5rem; border-color: rgba(251, 191, 36, 0.4);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <img src="/images/logo_gpp.png" alt="Logo Satuan Komunitas GPP Aceh" style="height: 42px; width: auto; filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.3));">
        <span style="width:1px;height:32px;background:rgba(251,191,36,0.3);display:inline-block;"></span>
        <img src="/images/logo_lp3_xvii.png" alt="Logo LP3 Putra Aceh" style="height: 54px; width: auto; filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.4));">
        <div>
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--gold-accent);">
            LP3 Putra XVII 2026 • Target Absensi:
          </div>
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin-top: 0.2rem;">
            <%= activeActivity ? activeActivity.name : 'Tidak Ada Kegiatan Aktif' %>
          </h2>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem;">
        <label for="scannerActivitySelect" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);">Ganti Kegiatan:</label>
        <select id="scannerActivitySelect" class="form-select" style="min-width: 250px;">
          <% activities.forEach(act => { %>
            <option value="<%= act.id %>" <%= activeActivity && activeActivity.id === act.id ? 'selected' : '' %>>
              <%= act.name %> (<%= act.type %>)
            </option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <div class="scanner-layout">
    <!-- Camera Viewport Box -->
    <div class="glass-card" style="padding: 1rem;">
      <!-- Camera Selection Toolbar -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 0.85rem; color: var(--text-secondary); font-weight: 600;">Pilih Kamera:</span>
          <select id="cameraDeviceSelect" class="form-select" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; width: auto; max-width: 220px;" onchange="changeCameraDevice(this.value)">
            <option value="">-- Memuat Kamera... --</option>
          </select>
        </div>

        <button id="btnStartCamera" onclick="restartCameraScanner()" class="btn btn-outline btn-sm">
          <%- icon('camera', 15) %> Izinkan / Aktifkan Kamera
        </button>
      </div>

      <div class="scanner-viewport">
        <div id="reader"></div>

        <!-- HUD Reticle Overlay -->
        <div class="scanner-overlay">
          <div class="scan-region">
            <div class="corner-bracket cb-tl"></div>
            <div class="corner-bracket cb-tr"></div>
            <div class="corner-bracket cb-bl"></div>
            <div class="corner-bracket cb-br"></div>
            <div class="scan-line"></div>
          </div>
        </div>

        <!-- Status Indicator Bar -->
        <div class="scanner-status-bar">
          <span class="pulse-dot"></span>
          <span id="scannerStatusText">● MEMUAT KAMERA LAPTOP...</span>
        </div>

        <!-- Result Popup Overlay -->
        <div id="resultOverlay" class="result-overlay">
          <div class="result-icon" style="padding: 0;"></div>
          <div class="result-title">ABSEN BERHASIL</div>
          <div class="result-subtitle res-name">Miftahul Rizki</div>
          
          <div class="result-details">
            <p>Pesantren: <strong class="res-school">Pesantren Al Zahrah Bireuen</strong></p>
            <p>Golongan: <strong class="res-category">PENEGAK</strong></p>
            <p>Kegiatan: <strong class="res-activity">Lomba Pionering</strong></p>
            <p>Waktu Scan: <strong class="res-time">10:24:32</strong></p>
          </div>
        </div>
      </div>

      <!-- Permission Guide Box if Camera Blocked -->
      <div id="cameraGuideBox" style="display: none; margin-top: 1rem; padding: 1rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--border-radius-md);">
        <h4 style="display:flex; align-items:center; gap:0.5rem; color: var(--color-danger); font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem;"><%- icon('alert', 16) %> Kamera Belum Diizinkan oleh Browser</h4>
        <ol style="font-size: 0.85rem; color: var(--text-secondary); margin-left: 1.25rem; line-height: 1.5;">
          <li>Klik ikon <strong>Kamera / Gembok</strong> di sebelah kiri alamat URL browser (<code id="scannerOriginUrl">...</code>).</li>
          <li>Ubah izin <strong>Kamera</strong> menjadi <strong>Izinkan</strong>.</li>
          <li>Klik tombol <strong>"Izinkan / Aktifkan Kamera"</strong> di atas.</li>
        </ol>
      </div>
    </div>

    <!-- Right Sidebar Controls & Mascot Guide -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      <!-- Mascot Guide Card -->
      <div class="glass-card" style="background: radial-gradient(circle at top right, rgba(251, 191, 36, 0.12), transparent 70%), var(--bg-glass); display: flex; align-items: center; gap: 1rem; padding: 1.25rem;">
        <img src="/images/maskot.png" alt="Maskot LP3 Putra XVII" style="height: 75px; width: auto; object-fit: contain; filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.4)); flex-shrink: 0;">
        <div>
          <h4 style="font-family: var(--font-tech); font-size: 0.95rem; color: var(--gold-accent);">MASKOT LP3 PUTRA XVII 2026</h4>
          <p style="font-size: 0.825rem; color: var(--text-secondary); margin-top: 0.2rem; line-height: 1.35;">
            "Jika kamera laptop belum aktif, klik tombol <b>Izinkan Kamera</b> atau gunakan form Input Manual di bawah!"
          </p>
        </div>
      </div>

      <!-- Manual Input Card -->
      <div class="glass-card">
        <div class="glass-card-title" style="margin-bottom: 1rem;">
          <%- icon('keyboard', 17) %> Input Manual Barcode
        </div>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;">
          Alternatif instan jika kamera tidak tersedia atau memakai Barcode Scanner USB.
        </p>

        <form id="manualScanForm">
          <div class="form-group">
            <label class="form-label" for="manualBarcodeInput">Barcode / QR ID Peserta</label>
            <input type="text" id="manualBarcodeInput" class="form-control" placeholder="Contoh: PRM-2026-0001" autocomplete="off" autofocus>
          </div>
          <button type="submit" class="btn btn-gold" style="width: 100%;">
            Proses Absensi
          </button>
        </form>
      </div>

      <!-- Quick Audio Toggle -->
      <div class="glass-card">
        <div class="glass-card-title" style="margin-bottom: 0.75rem;">
          <%- icon('sound', 17) %> Feedback Audio
        </div>
        <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
          <input type="checkbox" id="audioToggle" checked onchange="window.soundFx.enabled = this.checked" style="width: 18px; height: 18px; accent-color: var(--gold-accent);">
          <span style="font-size: 0.9rem; color: var(--text-primary);">Aktifkan Suara Beep Scan</span>
        </label>
      </div>

      <!-- Live Scan Counter Widget -->
      <div class="glass-card">
        <div class="glass-card-title" style="margin-bottom: 1rem;">
          <%- icon('chart', 17) %> Statistik Scan
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.5rem;">
          <span style="color: var(--text-secondary);">Hadir:</span>
          <strong id="widgetAttended" style="color: var(--color-success); font-family: var(--font-tech);"><%= activeActivity ? (activeActivity.attended_count || 0) : 0 %></strong>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.5rem;">
          <span style="color: var(--text-secondary);">Belum Hadir:</span>
          <strong id="widgetUnattended" style="color: var(--color-warning); font-family: var(--font-tech);"><%= activeActivity ? (activeActivity.unattended_count || 0) : 0 %></strong>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
          <span style="color: var(--text-secondary);">Persentase:</span>
          <strong id="widgetPercentage" style="color: var(--gold-accent); font-family: var(--font-tech);"><%= activeActivity ? (activeActivity.attendance_percentage || 0) : 0 %>%</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Scans Section -->
  <div class="glass-card" style="margin-top: 1.5rem;">
    <div class="glass-card-header">
      <div class="glass-card-title">
        <%- icon('history', 17) %> Log Scan Terakhir
      </div>
    </div>

    <div class="table-responsive">
      <table class="custom-table">
        <thead>
          <tr>
            <th>Barcode ID</th>
            <th>Nama Peserta</th>
            <th>Pesantren</th>
            <th>Golongan</th>
            <th>Kegiatan</th>
            <th>Waktu Scan</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="recentScansTableBody">
          <!-- Populated dynamically via scanner.js -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="/js/scanner.js"></script>
<%- include('layouts/footer') %>
