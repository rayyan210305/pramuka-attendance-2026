<%- include('layouts/header') %>
<div style="position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; overflow: hidden;">
  <!-- Watermark halaman: maskot LP3 XVII -->
  <div class="login-watermark" aria-hidden="true"></div>

  <div class="glass-card" style="position: relative; z-index: 1; width: 100%; max-width: 420px; padding: 2.5rem 2.25rem; border-color: rgba(251, 191, 36, 0.4);">
    <!-- Hero Maskot Kegiatan: Logo Burung LP3 -->
    <div style="display: flex; justify-content: center; margin-bottom: 0.6rem;">
      <img src="/images/logo_lp3_xvii.png" alt="Logo Kegiatan LP3 Putra Aceh" style="height: 180px; width: auto; filter: drop-shadow(0 0 18px rgba(251, 191, 36, 0.45));">
    </div>

    <!-- Identitas Penyelenggara -->
    <div style="display: flex; justify-content: center; align-items: center; gap: 0.85rem; margin-bottom: 1.5rem;">
      <img src="/images/logo_gpp.png" alt="Logo Satuan Komunitas GPP Aceh" style="height: 60px; width: auto; display: block; vertical-align: middle; filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.25));">
      <span style="width: 1px; height: 60px; background: rgba(251,191,36,0.25); display: inline-block;"></span>
      <span style="font-size: 0.72rem; color: var(--text-secondary); line-height: 1.4; white-space: nowrap;">Satuan Komunitas Gerakan Pramuka Aceh</span>
    </div>

    <h1 style="text-align: center; font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">
      Masuk Admin
    </h1>
    <p style="text-align: center; color: var(--text-secondary); font-size: 0.85rem; margin: 0.5rem 0 1.5rem;">
      LP3 Putra XVII 2026 
      Sistem Absensi QR
    </p>

    <% if (errorMessage) { %>
      <div style="display:flex; align-items:center; gap:0.5rem; color: var(--color-danger); background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.35); padding: 0.6rem 0.9rem; border-radius: var(--border-radius-md); font-size: 0.85rem; margin-bottom: 1.25rem;">
        <%- icon('alert', 16) %> <%= errorMessage %>
      </div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-group">
        <label class="form-label" for="loginPin">PIN Admin</label>
        <input type="password" id="loginPin" name="pin" class="form-control" placeholder="Masukkan PIN..." required autofocus style="letter-spacing: 4px; font-family: var(--font-tech);">
      </div>
      <button type="submit" class="btn btn-gold" style="width: 100%; padding: 0.85rem; font-size: 1rem;">
        <%- icon('lock', 16) %> Masuk ke Sistem
      </button>
    </form>

    <p style="text-align: center; color: var(--text-muted); font-size: 0.72rem; margin-top: 1.25rem;">
      Halaman ini khusus petugas/admin LP3 Putra XVII 2026.
    </p>
  </div>
</div>
<%- include('layouts/footer') %>