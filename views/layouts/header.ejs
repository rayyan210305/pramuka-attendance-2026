<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Pramuka Attendance System LP3 Putra XVII 2026' %></title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/logo_lp3_xvii.png">

  <script>
    (function () {
      try {
        var t = localStorage.getItem('lp3_theme');
        if (t !== 'light' && t !== 'dark') t = 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  
  <!-- CSS Stylesheets -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/scanner.css">

  <!-- Local Vendors for Camera QR Scanning & QR Generator -->
  <script src="/vendor/html5-qrcode.min.js"></script>
  <script src="/vendor/qrcode.min.js"></script>
</head>
