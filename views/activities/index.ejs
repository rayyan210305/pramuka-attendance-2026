<%- include('../layouts/header') %>
  <%- include('../layouts/navbar') %>

    <div class="main-wrapper">
      <div class="glass-card">
        <div class="glass-card-header">
          <div>
            <h2 class="page-title">Kegiatan & Lomba</h2>
            <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.2rem;">Satu event memiliki banyak
              kegiatan & perlombaan</p>
          </div>
          <button class="btn btn-primary" onclick="openModal('createActivityModal')">
            <%- icon('plus', 16) %> Tambah Kegiatan
          </button>
        </div>

        <div class="table-responsive">
          <table class="custom-table">
            <thead>
              <tr>
                <th>Status Aktif</th>
                <th>Nama Kegiatan</th>
                <th>Event Utama</th>
                <th>Jenis</th>
                <th>Tanggal</th>
                <th>Lokasi</th>
                <th>Waktu</th>
                <th>Kehadiran</th>
                <th>Status</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (activities && activities.length> 0) { %>
                <% activities.forEach(act=> { %>
                  <tr
                    style="<%= act.is_active ? 'border-left: 4px solid var(--cyan-primary); background: rgba(0,242,254,0.03);' : '' %>">
                    <td>
                      <% if (act.is_active) { %>
                        <span class="badge badge-active"><span class="pulse-dot"></span> Aktif
                          Sekarang</span>
                        <% } else { %>
                          <button class="btn btn-outline btn-sm" onclick="setActivityActive('<%= act.id %>')">Set
                            Aktif</button>
                          <% } %>
                    </td>
                    <td><strong>
                        <%= act.name %>
                      </strong></td>
                    <td>
                      <%= act.event_name || '-' %>
                    </td>
                    <td><span class="badge badge-type">
                        <%= act.type %>
                      </span></td>
                    <td>
                      <%= formatTanggal(act.date) %>
                    </td>
                    <td>
                      <%= act.location || '-' %>
                    </td>
                    <td>
                      <%= act.start_time %> - <%= act.end_time %>
                    </td>
                    <td>
                      <strong style="color: var(--cyan-primary);">
                        <%= act.attendance_count || 0 %>
                      </strong> / <%= act.total_participants || 0 %> Peserta
                    </td>
                    <td>
                      <span
                        class="badge <%= act.status === 'ACTIVE' ? 'badge-active' : (act.status === 'COMPLETED' ? 'badge-completed' : 'badge-scheduled') %>">
                        <%= act.status === 'ACTIVE' ? 'AKTIF' : act.status === 'COMPLETED' ? 'SELESAI' : act.status === 'SCHEDULED' ? 'TERJADWAL' : act.status === 'CANCELLED' ? 'DIBATALKAN' : act.status %>
                      </span>
                    </td>
                    <td>
                      <button class="btn btn-danger btn-sm"
                        onclick="deleteResource('/api/activities/<%= act.id %>', 'Kegiatan')">Hapus</button>
                    </td>
                  </tr>
                  <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="10" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada
                          kegiatan.</td>
                      </tr>
                      <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Modal Create Activity -->
    <div id="createActivityModal"
      style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 999; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
      <div class="glass-card" style="width: 100%; max-width: 550px; padding: 2rem;">
        <div class="glass-card-header">
          <h3 style="color: var(--text-primary);">Tambah Kegiatan / Lomba Baru</h3>
          <button class="btn btn-outline btn-sm" onclick="closeModal('createActivityModal')"><%- icon('x', 16) %></button>
        </div>
        <form id="createActivityForm">
          <div class="form-group">
            <label class="form-label">Acara Utama</label>
            <select name="event_id" class="form-select" required>
              <% events.forEach(e=> { %>
                <option value="<%= e.id %>">
                  <%= e.name %>
                </option>
                <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Nama Kegiatan / Lomba</label>
            <input type="text" name="name" class="form-control" placeholder="Contoh: Lomba Pionering" required>
          </div>
          <div class="form-group">
            <label class="form-label">Jenis Kegiatan / Lomba</label>
            <select name="type" class="form-select" required>
              <option value="KEGIATAN">KEGIATAN</option>
              <option value="LOMBA">LOMBA</option>
              <option value="EVENT">EVENT</option>
            </select>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Tanggal</label>
              <input type="date" name="date" class="form-control" required value="2026-08-05">
            </div>
            <div class="form-group">
              <label class="form-label">Jam Mulai</label>
              <input type="time" name="start_time" class="form-control" required value="10:00">
            </div>
            <div class="form-group">
              <label class="form-label">Jam Selesai</label>
              <input type="time" name="end_time" class="form-control" required value="11:30">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Lokasi / Tempat Kegiatan</label>
            <input type="text" name="location" class="form-control" placeholder="Contoh: Lapangan Pesantren Al Zahrah, Bireuen">
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" class="btn btn-outline" onclick="closeModal('createActivityModal')">Batal</button>
            <button type="submit" class="btn btn-primary">Simpan Kegiatan</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      document.getElementById('createActivityForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/activities', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (result.success) {
            showNotification('Berhasil', 'Kegiatan baru berhasil dibuat', 'success');
            setTimeout(() => location.reload(), 600);
          } else {
            showNotification('Gagal', result.message, 'danger');
          }
        } catch (err) {
          showNotification('Error', 'Terjadi kesalahan sistem', 'danger');
        }
      });
    </script>

    <%- include('../layouts/footer') %>